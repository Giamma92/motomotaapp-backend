{
    "version": 2,
    "builds": [{
        "src": "index.js", 
        "use": "@vercel/node"
    }],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/auto-score",
            "schedule": "*/10 * * * *"
        }
    ],
    "env": {
        "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/google-chrome"
    }
}